<div class="row r5"><div class="pn"><h4>Carbon over 12 months (sample)</h4><svg viewBox="0 0 300 70" width="100%" role="img" aria-label="Line chart: monthly carbon falling from high to low over 12 months"><polyline points="${pts}" fill="none" stroke="var(--g)" stroke-width="3" stroke-linejoin="round" transform="translate(0,4)"/></svg></div>
