html{scroll-padding-top:76px;scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 var(--b);-webkit-font-smoothing:antialiased;padding-bottom:env(safe-area-inset-bottom,0px)}
h1,h2,h3{font-family:var(--d);line-height:1.1;letter-spacing:-.02em;margin:0;font-weight:700}
h1{font-size:clamp(2.4rem,6.4vw,4.9rem)}h2{font-size:clamp(1.8rem,3.6vw,2.7rem)}h3{font-size:1.25rem;letter-spacing:-.01em}
p{margin:0 0 1em;max-width:66ch}a{color:inherit}
img{max-width:100%;height:auto;display:block}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px}
.skip{position:absolute;left:-999px;top:8px;background:var(--ink);color:var(--bg);padding:.6rem 1rem;z-index:50}.skip:focus{left:8px}
.wrap{max-width:1120px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}
header{position:sticky;top:0;z-index:40;background:var(--bg);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0px)}
.bar{display:flex;align-items:center;justify-content:space-between;min-height:64px;gap:16px}
.brand{font:700 1.15rem var(--d);text-decoration:none}
nav ul{display:flex;gap:4px;list-style:none;margin:0;padding:0;align-items:center}
nav a:not(.btn){display:inline-flex;align-items:center;min-height:44px;padding:0 12px;text-decoration:none;font-weight:500;border-radius:8px}
nav a:not(.btn):hover{background:var(--oat)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border-radius:10px;font-weight:700;text-decoration:none;border:2px solid var(--walnut);transition:background .15s,color .15s}
.btn.p{background:var(--walnut);color:var(--on)}.btn.p:hover{background:var(--ink);border-color:var(--ink)}.btn.s:hover{background:var(--oat)}
nav .btn{min-height:44px;padding:0 16px;margin-left:6px}
.menu{display:none;min-height:44px;min-width:44px;background:none;border:2px solid var(--line);border-radius:10px;color:inherit;font:700 .95rem var(--b);cursor:pointer;padding:0 14px}
.sec{padding:clamp(56px,9vw,104px) 0;border-top:1px solid var(--line)}
.hero{padding:clamp(48px,8vw,96px) 0 clamp(48px,7vw,80px)}
.hgrid{display:grid;grid-template-columns:1.5fr 1fr;gap:clamp(32px,5vw,64px);align-items:end}
.avail{display:inline-flex;gap:10px;align-items:center;background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:6px 16px 6px 12px;font-weight:500;font-size:.95rem;margin-bottom:28px}
.avail::before{content:"";width:10px;height:10px;border-radius:50%;background:#5E8C61}
.lead{font-size:1.2rem;color:var(--soft);margin:28px 0 32px}
.cta,.links{display:flex;flex-wrap:wrap;gap:12px}.links{margin-top:28px}
.ledger{background:var(--walnut);color:var(--on);border-radius:18px;padding:28px}
.ledger h2{font-size:1.5rem;margin-bottom:6px}.ledger p{color:inherit;opacity:.88;margin-bottom:18px}
.chips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:0}
.chips li{border:1px solid currentColor;border-radius:999px;padding:3px 13px;font-size:.92rem}
.ledger .chips li{border-color:rgba(251,247,239,.45)}
.head{margin-bottom:40px}.head p{color:var(--soft);margin:12px 0 0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.card{display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--line);border-radius:18px;overflow:hidden;text-decoration:none;transition:border-color .15s,transform .15s}
.card:hover{border-color:var(--walnut);transform:translateY(-2px)}
.card.big{grid-column:1/-1;flex-direction:row}
.cover{background:var(--oat);aspect-ratio:16/10;display:flex;flex-direction:column;justify-content:flex-end;padding:28px;overflow:hidden}
.card.big .cover{flex:1.1;aspect-ratio:auto;min-height:280px;background:var(--walnut);color:var(--on)}
.cover b{font:700 clamp(1.7rem,3vw,2.4rem)/1.05 var(--d);letter-spacing:-.02em;margin-bottom:14px}
.cover.img{padding:0;background:#cfe6c8}.cover.img img{width:100%;height:100%;object-fit:cover;object-position:top}
.cbody{padding:26px 28px 30px;flex:1;display:flex;flex-direction:column;gap:10px}
.card.big .cbody{justify-content:center}
.tag{color:var(--accent);font-weight:700;font-size:.95rem}
.cbody p{margin:0;color:var(--soft)}
.more{margin-top:auto;padding-top:10px;font-weight:700;text-decoration:underline;text-underline-offset:4px}
.exp,.about{display:grid;grid-template-columns:1fr 2fr;gap:clamp(24px,5vw,64px)}
.job{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:clamp(24px,4vw,40px)}
.job small,.meta dt{color:var(--soft);font-size:.95rem}
.job ul,.body ul{padding-left:1.2em;margin:14px 0 1em}.job li,.body li{margin-bottom:.4em}
.skills{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.skills>div{border-top:3px solid var(--walnut);padding-top:16px}.skills h3{margin-bottom:10px}
.skills ul{list-style:none;padding:0;margin:0;color:var(--soft)}.skills li{padding:3px 0}
.certs{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.certs>div{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:22px 24px}
.certs p{color:var(--soft);margin:4px 0 0}
.pdf{display:block;width:100%;height:min(80vh,900px);margin-top:28px;border:1px solid var(--line);border-radius:14px;background:var(--paper)}
.pdfnote{display:none;margin-top:20px;color:var(--soft)}
.contact{background:var(--oat)}.loc{margin:18px 0 0;color:var(--soft)}
footer{padding:28px 0 40px;color:var(--soft);font-size:.95rem;border-top:1px solid var(--line)}
.study{padding:clamp(40px,6vw,72px) 0}
.crumb{display:inline-flex;min-height:44px;align-items:center;font-weight:700;margin-bottom:24px}
.study h1{font-size:clamp(2.2rem,5.4vw,4rem);margin-bottom:20px}.study .lead{margin:0}
.meta{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin:40px 0;padding:24px 0;border-block:1px solid var(--line)}
.meta dd{margin:2px 0 0;font-weight:700}.meta div{min-width:0}
.mini{font-size:1.4rem;margin:36px 0 14px}
.embed{margin:40px 0}.embed p{color:var(--soft)}
.embed iframe{display:block;width:100%;height:min(82vh,820px);margin-top:20px;border:1px solid var(--line);border-radius:14px;background:var(--paper)}
.shots{display:grid;gap:32px;margin:40px 0}.shots figure{margin:0}.shots img{border:1px solid var(--line);border-radius:14px;width:100%}
.shots figcaption{color:var(--soft);font-size:.95rem;margin-top:10px}
.body{display:grid;gap:0;margin-top:40px}
.body .row{display:grid;grid-template-columns:1fr 2fr;gap:12px clamp(24px,5vw,64px);padding:28px 0;border-top:1px solid var(--line)}
.body h2{font-size:1.4rem}
.pn{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:56px}
@media(max-width:900px){.hgrid,.exp,.about,.body .row{grid-template-columns:1fr}.skills{grid-template-columns:1fr 1fr}.meta{grid-template-columns:1fr 1fr}.card.big{flex-direction:column}.card.big .cover{min-height:220px}}
