<script>
const $=s=>document.querySelector(s),app=$('#app');
const SRC=[['Transport','Trips and fuel'],['Home energy','Electricity use'],['Water','Water use'],['Waste','Recycling and waste']];
const ACT=[
{t:'Swap two car trips a week for bus or metro',why:'Transport is the largest category in this sample, so small changes there move the score most.',pts:4,kg:'about 18 kg CO₂e a month'},
{t:'Switch laundry to cold washes',why:'Heating water is a steady source of home energy use, and this change needs no daily effort.',pts:2,kg:'about 6 kg CO₂e a month'},
{t:'Start separating food waste',why:'Waste is the smallest category here, but it is a quick habit to build.',pts:2,kg:'about 4 kg CO₂e a month'}];
const S={screen:'onboarding',step:1,src:new Set([0,1]),done:[],chat:[{r:'m2',t:'Hi Maya. Ask me about your score or your next step.'}]};
const score=()=>Math.min(95,40+S.src.size*5+S.done.reduce((a,i)=>a+ACT[i].pts,0));
const next=()=>ACT.findIndex((a,i)=>!S.done.includes(i));
